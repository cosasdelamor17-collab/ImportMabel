{
  "$schema": "https://openapi.vercel.com/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/(.*)\\.php", "destination": "/$1.html" },
    { "source": "/index", "destination": "/index.html" },
    { "source": "/contacto", "destination": "/contacto.html" },
    { "source": "/productos", "destination": "/productos.html" },
    { "source": "/ubicacion", "destination": "/ubicacion.html" },
    { "source": "/vision-mision", "destination": "/vision-mision.html" }
  ]
}
